@startuml
title Блок-схема: регистрация нового члена семьи

start

repeat
  :Ввод логина;
  if (Логин занят?) then (да)
    :Вывести ошибку «Логин занят»;
  endif
repeat while (Логин занят?) is (да)

repeat
  :Ввод пароля;
  if (Пароль соответствует требованиям?) then (нет)
    :Вывести ошибку;
  endif
repeat while (Пароль соответствует требованиям?) is (нет)

repeat
  :Ввод имени;
  if (Данные корректны?) then (нет)
    :Вывести ошибку;
  endif
repeat while (Данные корректны?) is (нет)

:Сохранить пользователя в базе данных;
:Вывести сообщение «Пользователь добавлен»;

stop

@enduml